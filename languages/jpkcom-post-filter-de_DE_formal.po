#: includes/admin-pages.php:1445 includes/admin-pages.php:1656
msgid "Taxonomy Slug"
msgstr "Taxonomie-Slug"

#: includes/admin-pages.php:1445 includes/admin-pages.php:1656
msgid "Required"
msgstr "Pflichtfeld"

#: includes/admin-pages.php:1453 includes/admin-pages.php:1661
msgid ""
"Required. Unique slug for the new taxonomy, lowercase letters and hyphens "
"only (e.g. \"meine-themen\")."
msgstr ""
"Pflichtfeld. Eindeutiger Slug für die neue Taxonomie, nur Kleinbuchstaben "
"und Bindestriche (z. B. \"meine-themen\")."

#: includes/admin-pages.php:1457 includes/admin-pages.php:1665
msgid "Taxonomy"
msgstr "Taxonomie"

#: includes/admin-pages.php:1468 includes/admin-pages.php:1675
